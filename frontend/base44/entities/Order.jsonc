{
  "name": "Order",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "title": "\u0418\u043c\u044f \u043a\u043b\u0438\u0435\u043d\u0442\u0430"
    },
    "customer_phone": {
      "type": "string",
      "title": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d"
    },
    "customer_address": {
      "type": "string",
      "title": "\u0410\u0434\u0440\u0435\u0441 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"
    },
    "comment": {
      "type": "string",
      "title": "\u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439"
    },
    "delivery_type": {
      "type": "string",
      "title": "\u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f",
      "enum": [
        "delivery",
        "pickup"
      ],
      "default": "delivery"
    },
    "payment_method": {
      "type": "string",
      "title": "\u0421\u043f\u043e\u0441\u043e\u0431 \u043e\u043f\u043b\u0430\u0442\u044b",
      "enum": [
        "kaspi",
        "remote",
        "legal"
      ],
      "default": "kaspi"
    },
    "items": {
      "type": "array",
      "title": "\u0422\u043e\u0432\u0430\u0440\u044b",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_title": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "title": "\u0421\u0443\u043c\u043c\u0430 \u0431\u0435\u0437 \u0441\u043a\u0438\u0434\u043a\u0438"
    },
    "discount": {
      "type": "number",
      "title": "\u0421\u043a\u0438\u0434\u043a\u0430 (\u20b8)"
    },
    "total": {
      "type": "number",
      "title": "\u0418\u0442\u043e\u0433\u043e (\u20b8)"
    },
    "promo_code": {
      "type": "string",
      "title": "\u041f\u0440\u043e\u043c\u043e\u043a\u043e\u0434"
    },
    "status": {
      "type": "string",
      "title": "\u0421\u0442\u0430\u0442\u0443\u0441",
      "enum": [
        "new",
        "confirmed",
        "in_delivery",
        "completed",
        "cancelled"
      ],
      "default": "new"
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "total"
  ]
}